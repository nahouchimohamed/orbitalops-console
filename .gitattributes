# Prefer application languages in GitHub's language bar.
Makefile linguist-vendored
*.ps1 linguist-vendored
scripts/** linguist-vendored

# Generated code should not dominate stats.
**/*.pb.go linguist-generated=true

# Ensure app sources are counted.
*.go linguist-language=Go linguist-detectable=true
*.ts linguist-language=TypeScript linguist-detectable=true
*.tsx linguist-language=TypeScript linguist-detectable=true
