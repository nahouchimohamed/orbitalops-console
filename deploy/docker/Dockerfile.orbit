FROM golang:1.22-alpine AS build
WORKDIR /src
COPY services/orbit-service/go.mod services/orbit-service/go.sum* ./services/orbit-service/
WORKDIR /src/services/orbit-service
RUN go mod download
COPY services/orbit-service/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/orbit-service ./cmd/server

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/orbit-service /usr/local/bin/orbit-service
EXPOSE 50051 8082
ENTRYPOINT ["orbit-service"]
